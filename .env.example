MONGODB_URI=mongodb://127.0.0.1:27017/pryvet

# With AI_GATEWAY_API_KEY set, chat goes through Vercel's AI Gateway. Gateway model IDs are provider/model.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-6-luna
# The model that checks and repairs whole-document rewrites. Defaults to openai/gpt-6.1-sol.
AI_GATEWAY_CHECK_MODEL=

# Without it, chat goes to this endpoint through OpenAI's Responses API, like the local openai-oauth proxy. LLM_API_KEY is optional.
LLM_BASE_URL=http://127.0.0.1:10531/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# The model that checks and repairs whole-document rewrites. Defaults to gpt-6.1-sol.
LLM_CHECK_MODEL=
