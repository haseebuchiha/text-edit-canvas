          {
            "type": "text",
            "text": "Case Study: Predictive Maintenance at a Mid-sized Foundry"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "How [ORG_2] reduced unplanned downtime in its moulding line by more than half with the condition monitoring solution of [ORG_1]."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "At a Glance"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
