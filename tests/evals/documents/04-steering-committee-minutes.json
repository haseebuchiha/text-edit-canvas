          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The service contract for the shuttle system must be signed before the start of the trial operation."
                  }
                ]
              }
            ]
          }
        ]
